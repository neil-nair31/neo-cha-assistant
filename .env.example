# ─── Server ───────────────────────────────────────────────
PORT=8787
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:8787,https://www.neologistics.org

# ─── AI (server-side only — never expose to browser) ─────
# Provider: openai (OpenRouter) | gemini | anthropic
AI_PROVIDER=openai
OPENAI_API_KEY=sk-or-v1-your-openrouter-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Assist + Digest
AI_MODEL=openai/gpt-4o-mini
AI_MODEL_PREMIUM=openai/gpt-4o
# HS Finder — stronger model for definitive ranking
HS_AI_MODEL=openai/gpt-4o
DIGEST_AI_MODEL=openai/gpt-4o

# Gemini (optional fallback)
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your-google-ai-studio-key-here
# AI_MODEL=gemini-2.0-flash

# Claude (only if AI_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# AI_MODEL=claude-sonnet-4-20250514

# Storage: SQLite only (Postgres not implemented)
DATABASE_PATH=./data/neo-assistant.sqlite

# Optional: Voyage AI embeddings. If unset, local hybrid lexical RAG is used.
# VOYAGE_API_KEY=
# EMBEDDING_MODEL=voyage-3
# RERANK_MODEL=rerank-2

# ─── Lead notifications ───────────────────────────────────
NOTIFY_CHANNELS=email
LEAD_NOTIFY_EMAIL=customercare@neologistics.org
# Optional later:
# SLACK_WEBHOOK_URL=
# GOOGLE_SHEETS_WEBHOOK_URL=

# SMTP (if unset, emails are logged to console in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Neo Logistics Assistant <noreply@neologistics.org>"

# ─── DPDP / retention ─────────────────────────────────────
# Months to keep personal data (default 12)
DATA_RETENTION_MONTHS=12
PRIVACY_POLICY_URL=https://www.neologistics.org/contact-us/
# Public URL for deletion requests shown in consent UI
DATA_DELETION_EMAIL=customercare@neologistics.org

# ─── Rate limits ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=30
# Serious enquiry alert threshold (containers or kg heuristic)
HUGE_ENQUIRY_TEU=20
HUGE_ENQUIRY_NOTIFY=true

# ─── Languages ────────────────────────────────────────────
# Comma-separated. Launch: en only. Later: en,hi,ml
ALLOWED_LANGUAGES=en
DEFAULT_LANGUAGE=en

# ─── Feature 3: AI Customs Notifications Digest (port 8791) ─
NOTIFICATIONS_DIGEST_PORT=8791
# Content machine: scrapes CBIC/DGFT, posts only high-value Neo-relevant updates
DIGEST_AUTO_MACHINE=true
DIGEST_PUBLISH_MODE=auto
DIGEST_SCAN_INTERVAL_HOURS=6
DIGEST_MAX_NEW=5
DIGEST_MAX_PUBLISH_PER_DAY=5
DIGEST_MIN_NEED_SCORE=45
DIGEST_MIN_OK_CHANNELS=2
DIGEST_MIN_QUALITY=40
DIGEST_APPROVE_MIN_QUALITY=70
DIGEST_AUTO_PUBLISH_MIN_QUALITY=70
DIGEST_ADMIN_TOKEN=change-me-in-production
