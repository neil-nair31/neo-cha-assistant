FROM node:20-bookworm-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app

COPY package.json package-lock.json ./
COPY server/package.json ./server/
COPY widget/package.json ./widget/
COPY hs-lookup/package.json ./hs-lookup/
COPY notifications-digest/package.json ./notifications-digest/
COPY client-portal/package.json ./client-portal/
COPY client-portal/web/package.json ./client-portal/web/
RUN npm ci

COPY server ./server
COPY knowledge ./knowledge
COPY widget ./widget

RUN npm run build -w widget \
 && npm run build -w @neo-cha/server \
 && npm rebuild better-sqlite3 || true

ENV NODE_ENV=production
ENV PORT=8787
EXPOSE 8787
WORKDIR /app
CMD ["npm", "run", "start", "-w", "@neo-cha/server"]
