FROM node:20-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app

COPY package.json package-lock.json ./
COPY notifications-digest/package.json ./notifications-digest/
COPY server/package.json ./server/
COPY widget/package.json ./widget/
COPY hs-lookup/package.json ./hs-lookup/
COPY client-portal/package.json ./client-portal/
RUN npm ci --workspace=@neo-cha/notifications-digest --include-workspace-root 2>/dev/null || npm ci

COPY notifications-digest ./notifications-digest

ENV NODE_ENV=production
ENV NOTIFICATIONS_DIGEST_PORT=8791
EXPOSE 8791
WORKDIR /app
CMD ["npx", "tsx", "notifications-digest/src/server.ts"]
