FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY client-portal/package.json ./client-portal/
COPY client-portal/web/package.json ./client-portal/web/
COPY server/package.json ./server/
COPY widget/package.json ./widget/
COPY hs-lookup/package.json ./hs-lookup/
COPY notifications-digest/package.json ./notifications-digest/
RUN npm ci

COPY client-portal ./client-portal
WORKDIR /app/client-portal
RUN npm run build:web

FROM node:20-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app

COPY package.json package-lock.json ./
COPY client-portal/package.json ./client-portal/
COPY client-portal/web/package.json ./client-portal/web/
COPY server/package.json ./server/
COPY widget/package.json ./widget/
COPY hs-lookup/package.json ./hs-lookup/
COPY notifications-digest/package.json ./notifications-digest/
RUN npm ci --workspace=@neo-cha/client-portal --include-workspace-root 2>/dev/null || npm ci

COPY client-portal ./client-portal
COPY --from=build /app/client-portal/web/dist ./client-portal/web/dist

ENV NODE_ENV=production
ENV PORTAL_PORT=8792
EXPOSE 8792
WORKDIR /app
CMD ["npx", "tsx", "client-portal/src/server.ts"]
